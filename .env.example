# Скопировать в .env и заполнить. .env в .gitignore.
# Сервер инструментов читает этот файл сам (tools-server/src/lib/config.ts),
# поэтому в .gigacode/settings.json секретов нет.

# ── База знаний (вне этого репозитория) ─────────────────────────────────────
# Либо путь к существующему чекауту…
AI_DOCS_PATH=/Users/me/work/ai-docs
# …либо репозиторий, который склонирует ./scripts/sync-ai-docs.sh в AI_DOCS_PATH
# AI_DOCS_GIT_URL=git@git.company.ru:ai/ai-docs.git
# AI_DOCS_REF=master

# ── Чекаут сервиса, который агент правит по задаче ──────────────────────────
WORKSPACE_PATH=/Users/me/work/payment-service

# ── Репозиторий аналитики (SA specification) — источник требований ──────────
# gitlab | github | bitbucket | mock
SPEC_PROVIDER=gitlab
SPEC_BASE_URL=https://git.company.ru
SPEC_TOKEN=
# gitlab: числовой id или group/project; github: owner/repo
SPEC_PROJECT_ID=analytics/sa-specifications
# какие изменённые файлы считать спецификацией
SPEC_FILE_PATTERNS=.md,.markdown,.yaml,.yml,.json,.puml,.adoc
SPEC_MAX_FILE_BYTES=200000

# ── Jira ────────────────────────────────────────────────────────────────────
# local    — jira_get_issue ходит в Jira REST API прямо из be-tools
# external — jira_get_issue не регистрируется, работает внешний MCP-коннектор
# mock     — читает фикстуры из tools-server/fixtures/jira/<KEY>.json
JIRA_PROVIDER=local
JIRA_BASE_URL=https://jira.company.ru
# bearer — PAT (Jira Server/DC); basic — email + API token (Jira Cloud)
JIRA_AUTH=bearer
JIRA_TOKEN=
JIRA_EMAIL=

# Нужны только профилю settings.jira-mcp.json (подстановка {env:…})
# JIRA_MCP_URL=https://mcp.company.ru/jira
# JIRA_URL=https://jira.company.ru
# CONFLUENCE_MCP_URL=https://mcp.company.ru/confluence
# CONFLUENCE_TOKEN=
# CONFLUENCE_URL=https://confluence.company.ru

# ── Репозиторий сервиса (для create_merge_request) ──────────────────────────
VCS_PROVIDER=gitlab
VCS_BASE_URL=https://git.company.ru
VCS_TOKEN=
VCS_PROJECT_ID=payments/payment-service
VCS_TARGET_BRANCH=master

# ── Поведение сервера ───────────────────────────────────────────────────────
# false отключает создание инструментов агентом (аудит, прод-ограничения)
TOOLS_ALLOW_DYNAMIC=true
LOG_LEVEL=info
# LOG_FILE=/tmp/be-tools.log
