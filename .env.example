# Скопировать в .env и заполнить. .env в .gitignore.
# Сервер инструментов читает этот файл сам (tools-server/src/lib/config.ts),
# поэтому в .gigacode/settings.json секретов нет.

# ── База знаний (вне этого репозитория) ─────────────────────────────────────
# Либо путь к существующему чекауту…
AI_DOCS_PATH=/Users/me/work/ai-docs
# …либо репозиторий, который склонирует ./scripts/sync-ai-docs.sh в AI_DOCS_PATH
# AI_DOCS_GIT_URL=ssh://git@bitbucket.company.ru:7999/ai/ai-docs.git
# AI_DOCS_REF=master

# ── Репозиторий аналитики (SA specification) — источник требований ──────────
# external  — PR аналитики читает внешний MCP-сервер Bitbucket (профиль по умолчанию)
# bitbucket — spec_get_pr/spec_read_file ходят в Bitbucket Server сами
# mock      — фикстуры из tools-server/fixtures/spec/<id>.json
SPEC_PROVIDER=external
SPEC_BASE_URL=https://bitbucket.company.ru
# Bitbucket Server: КЛЮЧПРОЕКТА/repo-slug
SPEC_PROJECT_ID=SA/sa-specifications
# Необязателен, если Bitbucket доступен без авторизации
SPEC_TOKEN=
# какие изменённые файлы считать спецификацией
SPEC_FILE_PATTERNS=.md,.markdown,.yaml,.yml,.json,.puml,.adoc
SPEC_MAX_FILE_BYTES=200000

# ── Backend-микросервисы ────────────────────────────────────────────────────
# Чекаут сервиса агенту не выдаётся: он сам определяет по задаче, какие сервисы
# затронуты, достраивает адрес из префикса и клонирует их в WORKSPACES_DIR.

# Общий префикс адресов всех репозиториев сервисов (ssh или https)
SERVICES_GIT_BASE=ssh://git@bitbucket.company.ru:7999/be/
# Ключ проекта Bitbucket: нужен для service_list и для создания pull request
SERVICES_GROUP=BE
# Суффикс, который носят все backend-репозитории
SERVICES_SUFFIX=-be
# Куда складывать рабочие копии (в .gitignore)
WORKSPACES_DIR=workspaces
SERVICES_DEFAULT_BRANCH=master
# external — список репозиториев отдаёт внешний MCP Bitbucket
# bitbucket | mock — service_list работает сам
SERVICES_PROVIDER=external
SERVICES_API_URL=https://bitbucket.company.ru
SERVICES_TOKEN=
# 0 — полный клон; >0 — shallow на столько коммитов
SERVICES_CLONE_DEPTH=0

# ── Nexus ───────────────────────────────────────────────────────────────────
# Адрес отдаётся агенту через agent_context. Сервер инструментов сам в Nexus
# не ходит: как искать последнюю версию артефакта, агент решает сам.
NEXUS_URL=https://nexus.company.ru
# Репозиторий, если их несколько; пусто — агент определит сам
NEXUS_REPOSITORY=maven-releases
# Из имени сервиса получаются имена артефактов: service-be → service-be-api, …
NEXUS_ARTIFACT_SUFFIXES=-api,-roles-pprb
NEXUS_USER=
NEXUS_TOKEN=

# ── Jira ────────────────────────────────────────────────────────────────────
# external — тикет читает внешний MCP-сервер Jira (профиль по умолчанию)
# local    — jira_get_issue ходит в Jira REST API сам
# mock     — фикстуры из tools-server/fixtures/jira/<KEY>.json
JIRA_PROVIDER=external
JIRA_BASE_URL=https://jira.company.ru
# bearer — PAT (Jira Server/DC); basic — email + API token (Jira Cloud)
JIRA_AUTH=bearer
JIRA_TOKEN=
JIRA_EMAIL=

# Нужны профилю settings.external.json (подстановка {env:…} в settings.json)
BITBUCKET_MCP_URL=http://localhost:3000/mcp
JIRA_MCP_URL=http://localhost:3001/mcp
JIRA_URL=https://jira.company.ru

# ── Поведение сервера ───────────────────────────────────────────────────────
# false отключает создание инструментов и скилов агентом
TOOLS_ALLOW_DYNAMIC=true
SKILLS_ALLOW_CREATE=true
LOG_LEVEL=info
# LOG_FILE=/tmp/be-tools.log
