# Copy to .env and fill in. .env is gitignored and never read by the agent.
# The tool server reads these; .gigacode/settings.json holds no secrets.

# ── Где лежит база знаний и рабочая копия сервиса ───────────────────────────
AI_DOCS_PATH=ai-docs
# Чекаут сервиса, который агент правит по тикету. Обязательно переопределить.
WORKSPACE_PATH=/Users/me/work/payment-service
TOOLS_DYNAMIC_DIR=tools-server/dynamic

# ── Jira ────────────────────────────────────────────────────────────────────
# local    — jira_get_issue ходит в Jira REST API прямо из ts-сервера
# external — jira_get_issue не регистрируется, используется внешний MCP-коннектор
# mock     — читает фикстуры из tools-server/fixtures/jira/<KEY>.json
JIRA_PROVIDER=local
JIRA_BASE_URL=https://jira.company.ru
# bearer — PAT (Jira Server/DC); basic — email + API token (Jira Cloud)
JIRA_AUTH=bearer
JIRA_TOKEN=
JIRA_EMAIL=

# ── VCS (для create_merge_request) ──────────────────────────────────────────
VCS_PROVIDER=gitlab
VCS_BASE_URL=https://git.company.ru
VCS_TOKEN=
# gitlab: числовой id или group/project; github: owner/repo
VCS_PROJECT_ID=
VCS_TARGET_BRANCH=master

# ── Поведение сервера ───────────────────────────────────────────────────────
# false отключает создание инструментов агентом (аудит, прод-ограничения)
TOOLS_ALLOW_DYNAMIC=true
LOG_LEVEL=info
# LOG_FILE=/tmp/ai-tools-server.log
# TOOLS_SERVER_DEV=1   # запуск через tsx с горячей перезагрузкой
