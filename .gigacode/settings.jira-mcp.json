{
  "mcpServers": {
    "jira": {
      "httpUrl": "{env:JIRA_MCP_URL}",
      "headers": {
        "Authorization": "{env:JIRA_TOKEN}",
        "JIRA_URL": "{env:JIRA_URL}"
      },
      "timeout": 30000,
      "excludeTools": ["add_comment", "transition_issue", "update_issue", "create_issue"]
    },
    "confluence": {
      "httpUrl": "{env:CONFLUENCE_MCP_URL}",
      "headers": {
        "Authorization": "{env:CONFLUENCE_TOKEN}",
        "CONFLUENCE_URL": "{env:CONFLUENCE_URL}"
      },
      "timeout": 30000
    },
    "be-tools": {
      "command": "npx",
      "args": ["tsx", "src/index.ts"],
      "cwd": "tools-server",
      "timeout": 60000,
      "discoveryTimeoutMs": 60000,
      "trust": false
    }
  },
  "mcp": {
    "allowed": ["jira", "confluence", "be-tools"]
  },
  "$version": 4
}
